<odoo>
    <!-- Multi-company isolation for the invoice binding. The binding is
         tied to exactly one freee.backend (one Odoo company), so a user
         may only see/act on bindings whose backend belongs to a company
         in their allowed set. Mirrors freee_backend_company_rule in
         connector_freee_base; global rule (no groups) like that one. -->
    <record id="freee_account_move_company_rule" model="ir.rule">
        <field name="name">freee Invoice Binding: multi-company</field>
        <field name="model_id" ref="model_freee_account_move" />
        <field
            name="domain_force"
        >[('backend_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
